doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1 Custom Object Table
        a(href="/update-cobj") Add/Update this table
        table
            tr
                th Name
                th Lettuce
                th Cheese
                th Tomato
            each burger in data
                tr
                    td #{burger.properties.name}
                    td #{burger.properties.lettuce}
                    td #{burger.properties.cheese}
                    td #{burger.properties.tomato}